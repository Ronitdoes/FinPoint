# ==============================================================================
# AI Revenue Recovery — Environment Configuration Example
# Copy this file to .env or .env.local and populate the values
# ==============================================================================

# ------------------------------------------------------------------------------
# App & Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=8000
LOG_LEVEL=info

# Frontend-only variables (e.g. NEXT_PUBLIC_API_URL) belong in `.env.local`
# (gitignored). Next.js inlines NEXT_PUBLIC_* at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# PostgreSQL & Drizzle Database Connections (Neon / Lakebase Postgres)
# ------------------------------------------------------------------------------
# DATABASE_URL: Pooled connection string for normal application queries (Neon -pooler hostname)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/revenue_recovery"

# DIRECT_URL: Direct unpooled connection string for migrations and DDL (e.g. Neon, Supabase, PgBouncer)
DIRECT_URL="postgres://postgres:postgres@localhost:5432/revenue_recovery"

# ------------------------------------------------------------------------------
# Cache, Locks, Temporal & Event Streaming
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="revenue-recovery"
TEMPORAL_TASK_QUEUE="recovery-main"

# EVENT_BUS_DRIVER: "inprocess" (default, MVP fallback) or "redpanda".
# REDPANDA_BROKERS is required when EVENT_BUS_DRIVER=redpanda.
EVENT_BUS_DRIVER=inprocess
REDPANDA_BROKERS="localhost:9092"

# ------------------------------------------------------------------------------
# Authentication, Sessions & Bootstrap Admin (Step 09)
# ------------------------------------------------------------------------------
SESSION_SECRET="arr-session-secret-key-development-32chars"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="admin_password_123"
BOOTSTRAP_ADMIN_NAME="System Admin"
BOOTSTRAP_TENANT_NAME="Default Organization"

# ------------------------------------------------------------------------------
# AI & LLM Providers (Steps 14-15)
# ------------------------------------------------------------------------------
LLM_API_KEY=""
AI_MODEL="gpt-4o"
LLM_BASE_URL=
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# Payment Gateways (Stripe & Razorpay - Step 18)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# Messaging Providers (WhatsApp & Email - Step 19)
# ------------------------------------------------------------------------------
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_SECRET="whatsapp_webhook_verify_secret"

EMAIL_API_KEY=""
EMAIL_FROM="recovery@yourdomain.com"
EMAIL_WEBHOOK_SECRET="email_webhook_secret"

# ------------------------------------------------------------------------------
# Demo Mode & Failure-Injection Switches (spec 03 §2, §9)
# ------------------------------------------------------------------------------
# MOCK_PROVIDERS=true runs without live payment/messaging/LLM providers.
# Defaults to true except in production. When false, ALL provider credentials
# above become required at startup (fail-fast via @repo/config).
MOCK_PROVIDERS=true

SIMULATE_PAYMENT_TIMEOUT=false
SIMULATE_MESSAGE_FAILURE=false
SIMULATE_LLM_FAILURE=false
SIMULATE_DUPLICATE_WEBHOOK=false

# ------------------------------------------------------------------------------
# Observability (Step 08)
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
