# ==============================================================================
# AI Revenue Recovery — Environment Configuration Example
# Copy this file to .env or .env.local and populate the values
# ==============================================================================

# ------------------------------------------------------------------------------
# App & Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=8000
LOG_LEVEL=info

# Frontend-only variables (e.g. NEXT_PUBLIC_API_URL) belong in `.env.local`
# (gitignored). Next.js inlines NEXT_PUBLIC_* at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS_ALLOWED_ORIGINS: comma-separated extra origins for the backend CORS
# allowlist (consumed via @repo/config `config.http.corsAllowedOrigins`).
# Localhost/127.0.0.1 ports are always allowed in dev; set this for staging /
# production frontend origins.
CORS_ALLOWED_ORIGINS=
# COOKIE_SECURE: explicit override for the `rr_session` cookie Secure flag.
# Unset ⇒ derived from NODE_ENV (Secure in production). Set "true" to force
# Secure cookies in non-production behind HTTPS.
COOKIE_SECURE=

# ------------------------------------------------------------------------------
# PostgreSQL & Drizzle Database Connections (Neon / Lakebase Postgres)
# ------------------------------------------------------------------------------
# DATABASE_URL: Pooled connection string for normal application queries (Neon -pooler hostname)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/revenue_recovery"

# DIRECT_URL: Direct unpooled connection string for migrations and DDL (e.g. Neon, Supabase, PgBouncer)
DIRECT_URL="postgres://postgres:postgres@localhost:5432/revenue_recovery"

# ------------------------------------------------------------------------------
# Cache, Locks, Temporal & Event Streaming
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="revenue-recovery"
TEMPORAL_TASK_QUEUE="recovery-main"

# EVENT_BUS_DRIVER: "inprocess" (default, MVP fallback) or "redpanda".
# REDPANDA_BROKERS is required when EVENT_BUS_DRIVER=redpanda.
EVENT_BUS_DRIVER=inprocess
REDPANDA_BROKERS="localhost:9092"

# ------------------------------------------------------------------------------
# Authentication, Sessions & Bootstrap Admin (Step 09)
# ------------------------------------------------------------------------------
SESSION_SECRET="arr-session-secret-key-development-32chars"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="admin_password_123"
BOOTSTRAP_ADMIN_NAME="System Admin"
BOOTSTRAP_TENANT_NAME="Default Organization"

# ------------------------------------------------------------------------------
# AI & LLM Providers (Steps 14-15)
# ------------------------------------------------------------------------------
LLM_API_KEY=""
AI_MODEL="gpt-4o"
LLM_BASE_URL=
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# Payment Gateways (Stripe & Razorpay - Step 18)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# Messaging Providers (WhatsApp & Email - Step 19)
# ------------------------------------------------------------------------------
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_SECRET="whatsapp_webhook_verify_secret"

EMAIL_API_KEY=""
EMAIL_FROM="recovery@yourdomain.com"
EMAIL_WEBHOOK_SECRET="email_webhook_secret"

# ALLOW_UNSIGNED_WEBHOOKS: test/local-dev escape hatch for messaging webhooks
# (consumed via @repo/config `config.messaging.allowUnsignedWebhooks`).
# Unset ⇒ WhatsApp bypasses unsigned requests in non-prod only (production
# always requires x-hub-signature-256; set "false" to lock down non-prod too),
# email always requires a token (set "true" to bypass in non-prod for fixtures).
# Never set "true" in production.
# ALLOW_UNSIGNED_WEBHOOKS=

# ------------------------------------------------------------------------------
# Demo Mode & Failure-Injection Switches (spec 03 §2, §9)
# ------------------------------------------------------------------------------
# MOCK_PROVIDERS=true runs without live payment/messaging/LLM providers.
# Defaults to true except in production. When false, ALL provider credentials
# above become required at startup (fail-fast via @repo/config).
MOCK_PROVIDERS=true

SIMULATE_PAYMENT_TIMEOUT=false
SIMULATE_MESSAGE_FAILURE=false
SIMULATE_LLM_FAILURE=false
SIMULATE_DUPLICATE_WEBHOOK=false

# ------------------------------------------------------------------------------
# Observability (Step 08)
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=

# ------------------------------------------------------------------------------
# Background Crons & Deployment Metadata (Step 33)
# ------------------------------------------------------------------------------
# CRON_ENABLED master toggle for the in-process cron inventory
# (attribution hourly, cost audit daily, reconciler daily, retention monthly).
# Defaults ON except in test. Intervals in ms; every job is idempotent and
# overlap-guarded. Full inventory: docs/deploy/crons.md.
CRON_ENABLED=true
ATTRIBUTION_SWEEP_INTERVAL_MS=3600000
COST_AUDIT_INTERVAL_MS=86400000
RECONCILE_INTERVAL_MS=86400000
RETENTION_SWEEP_INTERVAL_MS=2592000000

# Release metadata baked into images at build time (never secrets).
# CI sets these from the git SHA / tag; entrypoint logs them at boot and
# GET /version exposes them for the staging smoke check.
APP_VERSION=dev
GIT_SHA=dev
# DEPLOY_ENV labels logs/metrics per environment (local | staging | production).
DEPLOY_ENV=local

# ------------------------------------------------------------------------------
# Monitoring, Alerting & Business KPIs (Step 34)
# ------------------------------------------------------------------------------
# PUSHGATEWAY_URL: Prometheus pushgateway for the 5-minute KPI snapshot job
# (ADR-016). Unset ⇒ gauges still refresh in-process for GET /metrics, but
# Grafana reads them only from the API's scrape target (single replica).
# Local compose exposes it at http://pushgateway:9091.
PUSHGATEWAY_URL=http://pushgateway:9091
# MONITORING_COHORT labels every kpi_* series (staging | prod). Per-tenant
# UUIDs never leave the process — tenants are summed into this one cohort.
MONITORING_COHORT=staging
KPI_SNAPSHOT_INTERVAL_MS=300000
INFRA_SAMPLER_INTERVAL_MS=60000

# ------------------------------------------------------------------------------
# Chaos & Resilience Drills (Step 31)
# ------------------------------------------------------------------------------
# FAULT_POINTS arms deterministic crash windows without code changes.
# Format: <activity>:<phase>,...  Phases: pre | post | after_claim |
# before_provider_call | after_provider_call. Example:
# FAULT_POINTS=claim:after_claim,executeRetryPayment:before_provider_call
# No-op in production unless CHAOS_ENABLED=true. Never point at prod tenants.
FAULT_POINTS=
CHAOS_ENABLED=false

# CHAOS_INFRA=1 enables the destructive compose kill drills (docker restart
# redis, 30s Postgres pause, worker SIGKILL, Redpanda stop/start). Nightly
# profile only; the fast per-push suite uses fakes and skips these.
CHAOS_INFRA=0
# Safety scope for kill drills (drills refuse prod-shaped values).
CHAOS_TARGET=development

# Container-name overrides for kill drills (defaults match the compose
# project naming; override when your checkout directory differs).
CHAOS_REDIS_CONTAINER=ai-revenue-recovery-redis-1
CHAOS_POSTGRES_CONTAINER=ai-revenue-recovery-postgres-1
CHAOS_WORKER_CONTAINER=ai-revenue-recovery-worker-1
CHAOS_REDPANDA_CONTAINER=ai-revenue-recovery-redpanda-1
