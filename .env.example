# ==============================================================================
# AI Revenue Recovery — Environment Configuration Example
# Copy this file to .env or .env.local and populate the values
#
# Source of truth for LOCAL defaults is docs/deploy/environments.md §2
# (staging/prod values live in the platform secret manager, never in git).
# Typed validation lives in packages/config/src/env.ts — every key below is
# either validated there, read by a vetted edge script/harness (see header
# in env.ts), interpolated by compose/Dockerfiles, or consumed by an ops
# script. Empty (=unset) is treated as unset by normalizeSource().
# ==============================================================================

# ------------------------------------------------------------------------------
# App & Server Configuration
# ------------------------------------------------------------------------------
# NODE_ENV: runtime mode. Controls effective defaults: MOCK_PROVIDERS defaults
# to true unless production; CRON_ENABLED defaults ON except in test;
# Secure cookies derived from production unless COOKIE_SECURE overrides.
NODE_ENV=development
# PORT: Fastify listen port. Default 8000; local compose overrides to 4000
# (backend publishes 4000:4000, so the effective local URL is :4000).
PORT=8000
# LOG_LEVEL: pino verbosity (trace|debug|info|warn|error|fatal). Staging info,
# production warn.
LOG_LEVEL=info

# Frontend-only variables (e.g. NEXT_PUBLIC_API_URL) belong in `.env.local`
# (gitignored). Next.js inlines NEXT_PUBLIC_* at build time.
# NEXT_PUBLIC_API_URL: browser-facing API base baked into the frontend image
# (sole permitted frontend build ARG; deploy-check enforces NEXT_PUBLIC_*).
# Local compose backend serves http://localhost:4000 (PORT=8000 default,
# overridden to 4000 by compose).
NEXT_PUBLIC_API_URL=http://localhost:4000

# CORS_ALLOWED_ORIGINS: comma-separated extra origins for the backend CORS
# allowlist (consumed via @repo/config `config.http.corsAllowedOrigins`).
# Localhost/127.0.0.1 ports are always allowed in dev; set this for staging /
# production frontend origins.
CORS_ALLOWED_ORIGINS=
# COOKIE_SECURE: explicit override for the `rr_session` cookie Secure flag.
# Unset ⇒ derived from NODE_ENV (Secure in production). Set "true" to force
# Secure cookies in non-production behind HTTPS.
COOKIE_SECURE=
# REQUEST_TIMEOUT_MS: default per-request budget in ms (Fastify request
# timeout). Default 10000 (10s). Must be a positive integer.
REQUEST_TIMEOUT_MS=10000
# WEBHOOK_TIMEOUT_MS: longer budget for provider webhook ingestion (signature
# verification + idempotent ingest while still acking fast). Default 25000
# (25s). Must be a positive integer.
WEBHOOK_TIMEOUT_MS=25000

# ------------------------------------------------------------------------------
# PostgreSQL & Drizzle Database Connections (Neon / Lakebase Postgres)
# ------------------------------------------------------------------------------
# DATABASE_URL: Pooled connection string for normal application queries (Neon -pooler hostname)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/revenue_recovery"

# DIRECT_URL: Direct unpooled connection string for migrations and DDL (e.g. Neon, Supabase, PgBouncer)
DIRECT_URL="postgres://postgres:postgres@localhost:5432/revenue_recovery"

# ------------------------------------------------------------------------------
# Cache, Locks, Temporal & Event Streaming
# ------------------------------------------------------------------------------
# REDIS_URL: Redis connection for rate limits, session hot-path cache (60s),
# 30s context cache, idempotency and delayed bus retries.
REDIS_URL="redis://localhost:6379"

# TEMPORAL_ADDRESS: Temporal frontend endpoint. Host processes use
# localhost:7233; compose services use temporal:7233 (container DNS).
TEMPORAL_ADDRESS="localhost:7233"
# TEMPORAL_NAMESPACE: workflow namespace (revenue-recovery locally;
# revenue-recovery-staging / -production per env, never shared).
TEMPORAL_NAMESPACE="revenue-recovery"
# TEMPORAL_TASK_QUEUE: worker poll queue (recovery-main everywhere).
TEMPORAL_TASK_QUEUE="recovery-main"

# EVENT_BUS_DRIVER: "inprocess" (default, MVP fallback) or "redpanda".
# REDPANDA_BROKERS is required when EVENT_BUS_DRIVER=redpanda.
EVENT_BUS_DRIVER=inprocess
# REDPANDA_BROKERS: Kafka bootstrap list. Host processes use localhost:9092;
# redpanda-console inside compose uses redpanda:29092 (see KAFKA_BROKERS below).
REDPANDA_BROKERS="localhost:9092"

# ------------------------------------------------------------------------------
# Authentication, Sessions & Bootstrap Admin (Step 09)
# ------------------------------------------------------------------------------
# SESSION_SECRET: signs the rr_session cookie (min 16 chars). Dev default is
# overridable anytime; staging/prod MUST use a 32+ char secret-manager ref.
SESSION_SECRET="arr-session-secret-key-development-32chars"
# BOOTSTRAP_ADMIN_EMAIL: initial ADMIN user email (seed-admin.ts, lowercase).
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
# BOOTSTRAP_ADMIN_PASSWORD: initial ADMIN password (min 8 chars via config;
# seed script falls back to a strong default when unset — set explicitly).
BOOTSTRAP_ADMIN_PASSWORD="admin_password_123"
# BOOTSTRAP_ADMIN_NAME: display name for the initial ADMIN user.
BOOTSTRAP_ADMIN_NAME="System Admin"
# BOOTSTRAP_TENANT_NAME: display name for the seeded demo tenant.
BOOTSTRAP_TENANT_NAME="Default Organization"
# BOOTSTRAP_TENANT_SLUG: URL-safe tenant slug for seed-admin.ts and
# packages/db seeds/demo.ts (lowercased/trimmed). Default demo-tenant.
BOOTSTRAP_TENANT_SLUG=demo-tenant
# BOOTSTRAP_RESET_PASSWORDS: "true" lets seed-admin.ts OVERWRITE existing
# password hashes on re-runs; default false preserves them. Never true in prod.
BOOTSTRAP_RESET_PASSWORDS=false
# SEED_DEMO_PERSONAS: "true" seeds the 4 demo-only personas (finance/ops/
# support/viewer) alongside ADMIN; otherwise ADMIN only (s-09 audit G-09-2).
SEED_DEMO_PERSONAS=true

# ------------------------------------------------------------------------------
# AI & LLM Providers (Steps 14-15)
# ------------------------------------------------------------------------------
# LLM_API_KEY: OpenAI-compatible provider key. Optional in mock mode; REQUIRED
# at boot when MOCK_PROVIDERS=false (fail-fast lists every missing live key).
LLM_API_KEY=""
# AI_MODEL: model id for decisions (pricing table is fail-closed on unknown
# models; staging may run a cheaper model than pinned prod).
AI_MODEL="gpt-4o"
# LLM_BASE_URL: custom OpenAI-compatible endpoint (proxies/self-hosted).
# Unset ⇒ provider default.
LLM_BASE_URL=
# LLM_TIMEOUT_MS: per-attempt LLM timeout in ms (circuit breaker 5 fails/60s).
LLM_TIMEOUT_MS=20000
# LLM_MAX_RETRIES: bounded retries with jittered backoff (N=2) + N=1 repair.
LLM_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# Payment Gateways (Stripe & Razorpay - Step 18)
# ------------------------------------------------------------------------------
# STRIPE_SECRET_KEY: Stripe API secret. Placeholder locally; TEST keys in
# staging, LIVE keys in prod (MOCK_PROVIDERS=false requires it).
STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET: Stripe webhook signing secret (constant-time HMAC,
# ±5m window). Also reused as k6 STRIPE_WEBHOOK_SECRET for the webhook_burst
# scenario (mapped from CI secret STAGING_STRIPE_WHSEC via -e).
STRIPE_WEBHOOK_SECRET="whsec_..."

# RAZORPAY_KEY_ID: Razorpay public key id (placeholder locally).
RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET: Razorpay API secret (required in live mode).
RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET: Razorpay webhook signing secret (HMAC).
RAZORPAY_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# Messaging Providers (WhatsApp & Email - Step 19)
# ------------------------------------------------------------------------------
# WHATSAPP_API_KEY: WhatsApp Cloud API token (required in live mode).
WHATSAPP_API_KEY=""
# WHATSAPP_PHONE_NUMBER_ID: sending number id (required in live mode).
WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_VERIFY_SECRET: Meta webhook verify-token (handshake) + HMAC secret.
# Optional in config (never in the live-required list) but needed for real
# WhatsApp webhooks; mock mode uses DEV_MOCK_* constants (code, not env).
WHATSAPP_VERIFY_SECRET="whatsapp_webhook_verify_secret"

# EMAIL_API_KEY: transactional email provider key (required in live mode).
EMAIL_API_KEY=""
# EMAIL_FROM: default sender address for case messages.
EMAIL_FROM="recovery@yourdomain.com"
# EMAIL_WEBHOOK_SECRET: inbound email webhook token (status receipts/bounces).
EMAIL_WEBHOOK_SECRET="email_webhook_secret"

# ALLOW_UNSIGNED_WEBHOOKS: test/local-dev escape hatch for messaging webhooks
# (consumed via @repo/config `config.messaging.allowUnsignedWebhooks`).
# Unset ⇒ WhatsApp bypasses unsigned requests in non-prod only (production
# always requires x-hub-signature-256; set "false" to lock down non-prod too),
# email always requires a token (set "true" to bypass in non-prod for fixtures).
# Never set "true" in production.
ALLOW_UNSIGNED_WEBHOOKS=

# ------------------------------------------------------------------------------
# Demo Mode & Failure-Injection Switches (spec 03 §2, §9)
# ------------------------------------------------------------------------------
# MOCK_PROVIDERS=true runs without live payment/messaging/LLM providers.
# Defaults to true except in production. When false, ALL provider credentials
# above become required at startup (fail-fast via @repo/config).
MOCK_PROVIDERS=true

# SIMULATE_PAYMENT_TIMEOUT: force payment adapter timeouts (resilience tests).
SIMULATE_PAYMENT_TIMEOUT=false
# SIMULATE_MESSAGE_FAILURE: force messaging adapter failures.
SIMULATE_MESSAGE_FAILURE=false
# SIMULATE_LLM_FAILURE: force LLM client failures (fallback path exercises).
SIMULATE_LLM_FAILURE=false
# SIMULATE_DUPLICATE_WEBHOOK: replay duplicate webhook deliveries (dedupe proof).
SIMULATE_DUPLICATE_WEBHOOK=false

# ------------------------------------------------------------------------------
# Observability (Step 08)
# ------------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT: OTLP collector URL (fire-and-forget export).
# Unset ⇒ tracing/logging run locally without export. Compose uses
# http://otel-collector:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ------------------------------------------------------------------------------
# Background Crons & Deployment Metadata (Step 33)
# ------------------------------------------------------------------------------
# CRON_ENABLED master toggle for the in-process cron inventory
# (attribution hourly, cost audit daily, reconciler daily, retention monthly).
# Defaults ON except in test. Intervals in ms; every job is idempotent and
# overlap-guarded. Full inventory: docs/deploy/crons.md.
CRON_ENABLED=true
# ATTRIBUTION_SWEEP_INTERVAL_MS: hourly outcome attribution sweeper.
ATTRIBUTION_SWEEP_INTERVAL_MS=3600000
# COST_AUDIT_INTERVAL_MS: daily action-cost completeness audit.
COST_AUDIT_INTERVAL_MS=86400000
# RECONCILE_INTERVAL_MS: daily orphaned-invoice + expired-PTP reconciler.
RECONCILE_INTERVAL_MS=86400000
# RETENTION_SWEEP_INTERVAL_MS: monthly audit-log retention archiver (30d).
RETENTION_SWEEP_INTERVAL_MS=2592000000

# Release metadata baked into images at build time (never secrets).
# CI sets these from the git SHA / tag; entrypoint logs them at boot and
# GET /version exposes them for the staging smoke check.
APP_VERSION=dev
GIT_SHA=dev
# DEPLOY_ENV labels logs/metrics per environment (local | staging | production).
# NOTE: read by infra/docker/backend-entrypoint.sh + compose + docs only — it is
# NOT part of @repo/config validation (no zod schema). Entrypoint defaults to
# local when unset.
DEPLOY_ENV=local

# ------------------------------------------------------------------------------
# Monitoring, Alerting & Business KPIs (Step 34)
# ------------------------------------------------------------------------------
# PUSHGATEWAY_URL: Prometheus pushgateway for the 5-minute KPI snapshot job
# (ADR-016). Unset ⇒ gauges still refresh in-process for GET /metrics, but
# Grafana reads them only from the API's scrape target (single replica).
# Local compose exposes it at http://pushgateway:9091.
PUSHGATEWAY_URL=http://pushgateway:9091
# MONITORING_COHORT labels every kpi_* series (staging | prod). Per-tenant
# UUIDs never leave the process — tenants are summed into this one cohort.
MONITORING_COHORT=staging
# KPI_SNAPSHOT_INTERVAL_MS: 5-minute KPI push cadence (ADR-016).
KPI_SNAPSHOT_INTERVAL_MS=300000
# INFRA_SAMPLER_INTERVAL_MS: 60s host/container/DB sampler cadence.
INFRA_SAMPLER_INTERVAL_MS=60000

# ------------------------------------------------------------------------------
# Chaos & Resilience Drills (Step 31)
# ------------------------------------------------------------------------------
# FAULT_POINTS arms deterministic crash windows without code changes.
# Format: <activity>:<phase>,...  Phases: pre | post | after_claim |
# before_provider_call | after_provider_call. Example:
# FAULT_POINTS=claim:after_claim,executeRetryPayment:before_provider_call
# No-op in production unless CHAOS_ENABLED=true. Never point at prod tenants.
FAULT_POINTS=
# CHAOS_ENABLED: master gate for fault-point crash windows ("true" arms).
# Production refuses unless explicitly true (fault-points.ts).
CHAOS_ENABLED=false

# CHAOS_INFRA=1 enables the destructive compose kill drills (docker restart
# redis, 30s Postgres pause, worker SIGKILL, Redpanda stop/start). Nightly
# profile only; the fast per-push suite uses fakes and skips these.
# (E2E docs also call this E2E_INFRA=1 for the restart-resilience drill —
# same gate, code reads CHAOS_INFRA via isInfraKillEnabled().)
CHAOS_INFRA=0
# Safety scope for kill drills (drills refuse prod-shaped values).
# Checked alongside NODE_ENV + APP_ENV in assertNonProd().
CHAOS_TARGET=development
# APP_ENV: chaos safety alias checked with NODE_ENV + CHAOS_TARGET
# (compose-admin.ts assertNonProd). Unset in normal dev; set to detect
# prod-shaped environments in custom harnesses.
APP_ENV=

# Container-name overrides for kill drills (defaults match the compose
# project naming; override when your checkout directory differs).
CHAOS_REDIS_CONTAINER=ai-revenue-recovery-redis-1
CHAOS_POSTGRES_CONTAINER=ai-revenue-recovery-postgres-1
CHAOS_WORKER_CONTAINER=ai-revenue-recovery-worker-1
CHAOS_REDPANDA_CONTAINER=ai-revenue-recovery-redpanda-1

# ------------------------------------------------------------------------------
# E2E Acceptance Harness (Step 32 — tests/e2e)
# ------------------------------------------------------------------------------
# E2E_BASE_URL: composed API target for the vitest e2e global-setup
# (waits for /health + /ready here so per-file setup stays fast). Unset ⇒
# in-process mode (each file boots its own buildApp + InProcessEventBus).
E2E_BASE_URL=
# FRONTEND_URL: composed frontend target for the dashboard UI smoke
# (dashboard.smoke.e2e.ts). Defaults to http://localhost:3000 when unset.
FRONTEND_URL=http://localhost:3000
# E2E_MINIMAL_SEED: reserved by tests/e2e/setup/compose.e2e.yml backend env
# ("true" = deterministic minimal fixture set, NOT the s-29 volume seed).
# Declared by the e2e compose profile; no code reader yet (contract key).
E2E_MINIMAL_SEED=
# E2E_SCENARIO: reserved by compose.e2e.yml (e.g. scenario-a). Same contract
# note as E2E_MINIMAL_SEED — kept here for discoverability.
E2E_SCENARIO=

# ------------------------------------------------------------------------------
# Post-Deploy Smoke, Rollback & Audit Gates (Steps 30/33 — scripts/)
# ------------------------------------------------------------------------------
# SMOKE_BASE_URL: staging smoke target (scripts/smoke-staging.mjs, REQUIRED).
# e.g. https://api-staging.example.com. Exits 1 when empty.
SMOKE_BASE_URL=
# SMOKE_EXPECT_SHA: exact GIT_SHA the deploy should serve (verified against
# GET /version — proves the new tag is live, not stale replicas). Optional.
SMOKE_EXPECT_SHA=
# SMOKE_STRICT_PROD_SHAPE: "true" (default) requires /demo/* to 404
# (prod-shape proof); "false" allows non-strict staging-drill shape.
SMOKE_STRICT_PROD_SHAPE=true
# ROLLBACK_TAG: previous immutable image tag to restore
# (scripts/rollback-compat-check.mjs, REQUIRED; sourced from the rollback
# workflow input target_tag). Exits 1 when empty.
ROLLBACK_TAG=
# CONFIRM_SCHEMA_COMPAT: must be "true" to allow rollback (explicit human flag
# acknowledging forward-only migrations — app rolls back, schema stays;
# sourced from repo/environment var CONFIRM_SCHEMA_COMPAT).
CONFIRM_SCHEMA_COMPAT=false
# AUDIT_FAIL_LEVEL: dependency-audit severity threshold
# (critical|high|moderate|low). Default critical.
AUDIT_FAIL_LEVEL=critical

# ------------------------------------------------------------------------------
# k6 Load Smoke (Step 34 — infra/load/k6-smoke.js, `__ENV`, not process.env)
# ------------------------------------------------------------------------------
# BASE_URL: k6 target (const BASE_URL = __ENV.BASE_URL). Distinct from
# SMOKE_BASE_URL (post-deploy probe) and E2E_BASE_URL (vitest harness).
BASE_URL=http://localhost:4000
# API_TOKEN: k6 read-APIs bearer (rrk_*). Empty ⇒ unauthenticated reads
# (expects 401 as pass). In CI mapped via -e API_TOKEN=$STAGING_API_TOKEN.
API_TOKEN=
# NOTE: k6 STRIPE_WEBHOOK_SECRET reuses the app STRIPE_WEBHOOK_SECRET above
# (CI maps -e STRIPE_WEBHOOK_SECRET=$STAGING_STRIPE_WHSEC). No second key.

# ------------------------------------------------------------------------------
# Local Infra Internals — MANAGED BY COMPOSE, do NOT set in .env
# ------------------------------------------------------------------------------
# Documented here for discoverability only. These are hardcoded in
# infra/docker/docker-compose.yml (dev-only values) and never read from .env:
#   POSTGRES_USER=postgres / POSTGRES_PASSWORD=postgres / POSTGRES_DB=revenue_recovery
#   DB=postgres12 / DB_PORT=5432 / POSTGRES_SEEDS=postgres / POSTGRES_PWD=postgres
#   DBNAME=temporal / VISIBILITY_DBNAME=temporal_visibility
#   ENABLE_NAMESPACE_CREATE=true / DEFAULT_NAMESPACE=revenue-recovery
#   TEMPORAL_CORS_ORIGINS=http://localhost:3000 (temporal-ui)
#   KAFKA_BROKERS=redpanda:29092 / SERVER_LISTENPORT=8081 (redpanda-console)
#   REDIS_ADDR=redis://redis:6379 (redis-exporter)
#   DATA_SOURCE_NAME=postgresql://...?sslmode=disable (postgres-exporter, dev-only)
#   GF_SECURITY_ADMIN_USER=admin / GF_SECURITY_ADMIN_PASSWORD=admin (grafana dev-only)
#   GF_AUTH_ANONYMOUS_ENABLED=false / GF_USERS_ALLOW_SIGN_UP=false
#   GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/executive.json
# Dockerfile-only runtime (baked via ENV, not .env):
#   HOST=0.0.0.0 (backend) / HOSTNAME=0.0.0.0 + NEXT_TELEMETRY_DISABLED=1 (frontend)
# CI / GitHub secrets (workflows + secret store, NEVER in .env):
#   REGISTRY / BACKEND_IMAGE / FRONTEND_IMAGE / PERF_BASELINE_FILE / K6_WEBHOOKS_URL
#   STAGING_* (DATABASE_URL, DIRECT_URL, REDIS_URL, TEMPORAL_ADDRESS,
#     REDPANDA_BROKERS, DEPLOY_HOOK_URL, BASE_URL, API_TOKEN, STRIPE_WHSEC,
#     PUBLIC_API_URL) / PROD_* equivalents / GITHUB_TOKEN / GITHUB_OUTPUT
# Code constants mistaken for env (NOT env vars, do not add):
#   E2E_AMOUNTS (tests/e2e/support/e2e-harness.ts fixture map) /
#   DEV_MOCK_STRIPE_WEBHOOK_SECRET + DEV_MOCK_RAZORPAY_WEBHOOK_SECRET
#   (apps/backend/src/modules/demo/simulator.service.ts mock loopback constants)
