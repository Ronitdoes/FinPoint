{
  "name": "AI-Revenue-Recovery",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "test": "vitest run",
    "test:security": "vitest run tests/security apps/backend/src/tests/security.test.ts apps/backend/src/tests/rate-limit-auth.test.ts apps/backend/src/tests/auth.test.ts apps/backend/src/tests/webhooks.test.ts apps/backend/src/tests/events.test.ts apps/backend/src/tests/customer-context.test.ts apps/backend/src/tests/policy-integration.test.ts apps/backend/src/tests/audit-timeline-integration.test.ts apps/backend/src/tests/ai-governance-adversarial.test.ts apps/backend/src/tests/messaging-integration.test.ts",
    "test:chaos": "vitest run --project chaos",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:coverage": "bun scripts/e2e-coverage-check.mjs",
    "security:sweep": "bun scripts/security-sweep.mjs",
    "security:audit": "bun scripts/dependency-audit.mjs",
    "boundaries:audit": "bun scripts/audit-boundaries.ts",
    "deploy:check": "bun scripts/deploy-check.mjs",
    "smoke:staging": "bun scripts/smoke-staging.mjs",
    "rollback:compat-check": "bun scripts/rollback-compat-check.mjs",
    "check-docs": "bun scripts/check-docs-links.mjs",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:migrate": "bun --filter @repo/db db:migrate",
    "db:migrate:check": "bun --filter @repo/db db:migrate:check",
    "db:seed": "bun --filter @repo/db db:seed",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d --wait",
    "infra:up:build": "docker compose -f infra/docker/docker-compose.yml up -d --build --wait",
    "infra:build": "docker compose -f infra/docker/docker-compose.yml build",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/integrations": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/worker": "workspace:*",
    "@types/node": "^20",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "prettier": "^3.7.4",
    "turbo": "^2.10.11",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ]
}
